rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /retiros/{sala} {
      // Cualquiera puede leer cuántas piezas van liberadas.
      allow read: if true;
      // Solo el administrador (su correo de Google) puede cambiarlo, y solo a un número de 0 a 7.
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.token.email == 'su-correo@gmail.com'
                   && request.resource.data.keys().hasOnly(['liberadas'])
                   && request.resource.data.liberadas is int
                   && request.resource.data.liberadas >= 0
                   && request.resource.data.liberadas <= 7;
    }
  }
}
